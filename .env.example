# ==========================================
# FinBot Environment Configuration Template
# ==========================================
# Copy this file to .env and replace the placeholder values with your credentials.
# DO NOT commit your actual .env file to Git repository.

# ------------------------------------------
# 1. LLM & Embeddings API Credentials
# ------------------------------------------
# OpenAI API Key (Required for GPT models & Batch API graph extraction)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face Hub Token (Optional: Required if using private/gated HF embedding models)
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# ------------------------------------------
# 2. Vector DB (ChromaDB) Configuration
# ------------------------------------------
# Directory where ChromaDB vector index is stored
CHROMA_PERSIST_DIR=./chroma_db

# Collection name for newspaper/document embeddings
CHROMA_COLLECTION_NAME=finbot_newspapers

# ------------------------------------------
# 3. Knowledge Graph (Neo4j) Configuration
# ------------------------------------------
# Bolt connection URI for Neo4j instance
NEO4J_URI=bolt://localhost:7687

# Authentication credentials
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ------------------------------------------
# 4. Short-Lived Memory (Redis) Configuration
# ------------------------------------------
# Redis server host and port
REDIS_HOST=localhost
REDIS_PORT=6379

# Password (leave empty if local Redis instance has no auth)
REDIS_PASSWORD=

# Session Memory Expiration Time-To-Live (in seconds)
# Default: 3600 (1 hour of inactivity before session history automatically expires)
REDIS_TTL_SECONDS=3600